{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false, "skipLibCheck": true, "isolatedModules": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "resolveJsonModule": true,
    "types": ["vite/client"], "noEmit": true, "esModuleInterop": true
  },
  "include": ["src", "test", "scripts", "e2e", "dev", "vite.config.ts", "playwright.config.ts"]
}
