{
  "name": "Fylz Viewer",
  "short_name": "Fylz Viewer",
  "description": "View any file, edit the common ones. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14161a",
  "theme_color": "#1a5fd0",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/*": [".txt", ".md", ".log", ".csv", ".tsv", ".json", ".yaml", ".yml", ".toml", ".xml", ".html", ".ini", ".env"],
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".avif", ".bmp", ".ico", ".svg"],
        "audio/*": [".mp3", ".m4a", ".ogg", ".opus", ".flac", ".wav"],
        "video/*": [".mp4", ".webm", ".mkv", ".mov"],
        "application/pdf": [".pdf"],
        "application/zip": [".zip", ".docx", ".xlsx", ".pptx", ".odt", ".ods", ".odp", ".epub", ".jar", ".apk"],
        "application/octet-stream": [".bin", ".7z", ".rar", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".ttf", ".otf", ".woff", ".woff2", ".sqlite", ".db"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["*/*"] }] }
  }
}
