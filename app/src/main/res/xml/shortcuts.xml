<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="operation_history"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:shortcutShortLabel="@string/operation_history_title"
        android:shortcutLongLabel="@string/operation_history_shortcut_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.mbaliga.fylz"
            android:targetClass="io.github.mbaliga.fylz.OperationHistoryActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="advanced_tools"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_manage"
        android:shortcutShortLabel="@string/post_v1_tools_title"
        android:shortcutLongLabel="@string/post_v1_tools_shortcut_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.mbaliga.fylz"
            android:targetClass="io.github.mbaliga.fylz.PostV1ToolsActivity" />
    </shortcut>
    <!--
        IndexManagerActivity had no manifest declaration at all until now, so nothing could reach
        the index/ package. It is exported="false", which a launcher shortcut with an explicit
        targetClass can still start because the shortcut is published by this same app.
    -->
    <shortcut
        android:shortcutId="index_manager"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:shortcutShortLabel="@string/index_manager_title"
        android:shortcutLongLabel="@string/index_manager_shortcut_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.mbaliga.fylz"
            android:targetClass="io.github.mbaliga.fylz.IndexManagerActivity" />
    </shortcut>

    <!--
        Action-only shortcuts (no extras): each intent's android:action literal must match
        io.github.mbaliga.fylz.intents.FylzIntents' own constant exactly, since a manifest XML
        cannot reference a Kotlin const val. FylzIntentsTest pins the constants' actual values;
        keep both in sync by hand if either ever changes.
    -->
    <shortcut
        android:shortcutId="scan_document"
        android:enabled="true"
        android:icon="@drawable/ic_widget_scan"
        android:shortcutShortLabel="@string/shortcut_scan_short"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="io.github.mbaliga.fylz.action.SCAN"
            android:targetPackage="io.github.mbaliga.fylz"
            android:targetClass="io.github.mbaliga.fylz.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_widget_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="io.github.mbaliga.fylz.action.SEARCH"
            android:targetPackage="io.github.mbaliga.fylz"
            android:targetClass="io.github.mbaliga.fylz.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shelf"
        android:enabled="true"
        android:icon="@drawable/ic_widget_shelf"
        android:shortcutShortLabel="@string/shortcut_shelf_short"
        android:shortcutLongLabel="@string/shortcut_shelf_long">
        <intent
            android:action="io.github.mbaliga.fylz.action.OPEN_SHELF"
            android:targetPackage="io.github.mbaliga.fylz"
            android:targetClass="io.github.mbaliga.fylz.MainActivity" />
    </shortcut>
</shortcuts>
