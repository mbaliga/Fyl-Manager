<?xml version="1.0" encoding="utf-8"?>
<!--
    In progress widget (docs/widgets.md). Resizable from 2x1 upwards; Fylz hands the launcher one layout per
    size (widget/WidgetSize.kt) and pushes updates itself, so updatePeriodMillis is 0.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_operations_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_fallback"
    android:previewLayout="@layout/widget_preview_operations"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
