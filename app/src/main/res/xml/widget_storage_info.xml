<?xml version="1.0" encoding="utf-8"?>
<!--
    Metadata for io.github.mbaliga.fylz.widgets.StorageWidgetProvider. updatePeriodMillis is
    deliberately 0 — WidgetRefreshWorker's own 6-hour WorkManager job is this widget's only
    scheduled refresh path (see that class's KDoc), so there is exactly one cadence to reason
    about instead of two racing ones.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_storage"
    android:previewLayout="@layout/widget_storage"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_storage_description" />
