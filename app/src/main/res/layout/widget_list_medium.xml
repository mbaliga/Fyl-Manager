<?xml version="1.0" encoding="utf-8"?>
<!--
    Fylz widget template, MEDIUM (about 4x2): a header, up to two one-line rows (glyph, title,
    trailing value, optional bar) and a footer. Rows here are never tap targets of their own: two
    48dp targets do not fit in 110dp, so the whole widget is the one target. Unused rows stay gone.
    Filled by widget/WidgetTemplates.kt.
    The title and the footer are pinned; everything between them sits in a weighted body that
    clips at its own bottom, so when text is scaled up the body is cut, never the footer with its
    "as of" time. What each widget puts here is budgeted against this size in WidgetFitTest.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/widget_trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        tools:ignore="NestedWeights">
        <LinearLayout
            android:id="@+id/widget_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_row_1_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/widget_row_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row_1_trailing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/widget_row_1_bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_accent"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_row_2_glyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/widget_row_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row_2_trailing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/widget_row_2_bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
