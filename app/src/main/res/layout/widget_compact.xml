<?xml version="1.0" encoding="utf-8"?>
<!--
    Fylz widget template, COMPACT (about 2x1): one line and an optional bar, sized to fit the 40dp
    COMPACT height. The whole widget is one tap target. Filled by widget/WidgetTemplates.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_compact_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_folder"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_compact_glyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="16sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_compact_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_compact_bar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:max="1000"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_accent"
        android:visibility="gone" />
</LinearLayout>
