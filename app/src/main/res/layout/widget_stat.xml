<?xml version="1.0" encoding="utf-8"?>
<!--
    Fylz widget template, SMALL (about 2x2): a title, one value with its glyph, a caption, an
    optional bar and an "as of" footer. Filled by widget/WidgetTemplates.kt.
    The title and the footer are pinned; everything between them sits in a weighted body that
    clips at its own bottom, so when text is scaled up the body is cut, never the footer with its
    "as of" time. What each widget puts here is budgeted against this size in WidgetFitTest.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        tools:ignore="NestedWeights">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/widget_headline_glyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="18sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_bar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:max="1000"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progressBackgroundTint="@color/widget_track"
            android:progressTint="@color/widget_accent"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />
</LinearLayout>
