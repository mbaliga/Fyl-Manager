<?xml version="1.0" encoding="utf-8"?>
<!--
    QuickActionsWidgetProvider's 2x1 face: four one-tap actions — Scan, Search, Shelf, Trash —
    each its own icon+label pair, own PendingIntent straight to MainActivity (set by
    QuickActionsWidgetProvider.buildViews, keyed off these same ids), and its own ripple.
    RemoteViews-safe views only: LinearLayout, ImageView, TextView.

    Build 11.5 inset rule: 14dp root padding, matching widget_storage.xml — the 1x1 folder widget
    is this rule's only documented exception, at 10dp.

    Each action is its own vertical LinearLayout rather than the old flat ImageButton row: a
    RemoteViews-safe container can carry a click target (QuickActionsWidgetProvider calls
    setOnClickPendingIntent on these same ids, unchanged by this layout restructure) exactly like
    a button can, but only a container can stack an icon over an 11sp label. Each one gets
    ?android:attr/selectableItemBackgroundBorderless for a real ripple/pressed state — the old
    android:background="@android:color/transparent" ImageButtons had none. That attribute is a
    plain android: framework theme reference (not an AppCompat one), so it resolves fine against
    whatever theme the widget host inflates this layout with, the same reasoning as the
    android:tint note below.

    Icon android:contentDescription="@null" is deliberate, not an omission: each icon now sits
    directly above its own visible text label (the same icon+adjacent-visible-label pairing
    widget_folder.xml already uses), so the label supplies the accessible name and a duplicate
    content description would just make a screen reader announce the same word twice.

    android:tint (not app:tint) below is deliberate, not the lint UseAppTint suggestion left
    unaddressed: a widget host inflates RemoteViews as plain framework views, never through
    AppCompat's LayoutInflater factory, so app:tint (an AppCompat-only attribute) would silently
    do nothing here. Plain android:tint on ImageView has been framework-native since API 21,
    well under this app's minSdk 31.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_actions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_action_scan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_scan"
            android:tint="@color/widget_accent"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:fontFamily="@font/hyle_grotesk_classic_regular"
            android:text="@string/widget_action_scan" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_search"
            android:tint="@color/widget_accent"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:fontFamily="@font/hyle_grotesk_classic_regular"
            android:text="@string/widget_action_search" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_shelf"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shelf"
            android:tint="@color/widget_accent"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:fontFamily="@font/hyle_grotesk_classic_regular"
            android:text="@string/widget_action_shelf" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_action_trash"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_trash"
            android:tint="@color/widget_accent"
            tools:ignore="UseAppTint"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:fontFamily="@font/hyle_grotesk_classic_regular"
            android:text="@string/widget_action_trash" />
    </LinearLayout>
</LinearLayout>
