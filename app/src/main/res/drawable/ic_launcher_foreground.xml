<?xml version="1.0" encoding="utf-8"?>
<!--
    Fylz launcher foreground: a folder mark with a stacked "workspace" edge, drawn inside the
    66dp adaptive-icon safe zone (the outer 18dp of the 108dp canvas can be masked away by any
    launcher shape, so nothing meaningful is placed there).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back sheet, offset up-right to read as a stack of locations. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M40,32h13l5,6h17a4,4 0,0 1,4 4v6h-39z" />

    <!-- Main folder body. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,40h14l5,6h21a5,5 0,0 1,5 5v22a5,5 0,0 1,-5 5h-40a5,5 0,0 1,-5 -5v-28a5,5 0,0 1,5 -5z" />

    <!-- Two content lines: the "workspace, not cleaner" wedge from the product brief. -->
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M40,58h28v4h-28z" />
    <path
        android:fillColor="#1B3A2A"
        android:pathData="M40,66h18v4h-18z" />
</vector>
