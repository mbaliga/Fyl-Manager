    <string name="share_result_partial">%1$d file(s) shelved to Inbox, %2$d failed</string>
    <string name="share_result_all_failed">Could not shelve any files</string>

    <!-- New static shortcuts (res/xml/shortcuts.xml) -->
    <string name="shortcut_scan_short">Scan</string>
    <string name="shortcut_scan_long">Scan storage</string>
    <string name="shortcut_search_short">Search</string>
    <string name="shortcut_search_long">Search Fylz</string>
    <string name="shortcut_shelf_short">Shelf</string>
    <string name="shortcut_shelf_long">Open the Shelf</string>
</resources>
