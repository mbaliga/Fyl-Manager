<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Normal (non-dangerous) permission, no runtime request needed: required for
         HyleTabHaptics.settle()'s direct VibratorManager.vibrate() call. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Fylz is a file manager: full filesystem access is its default posture, not an opt-in
        extra. MANAGE_EXTERNAL_STORAGE is a special access permission and cannot be requested
        with a runtime permission dialog; storage.FullAccessPermission sends the user to the
        system "All files access" screen and re-checks Environment.isExternalStorageManager()
        when they return.

        Declining is survivable: StorageAccess falls back to the Storage Access Framework path,
        which also remains the only way to reach cloud, USB and third-party DocumentsProvider
        roots that this permission does not cover.

        tools:ignore="ScopedStorage" — lint flags this permission unconditionally. Publishing on
        Google Play with it requires the file-manager Permissions Declaration and eligibility
        review; see docs/ARCHITECTURE.md.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".FylzApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fylz"
        android:usesCleartextTraffic="false">

        <!--
            Fylz's own DocumentsProvider over java.io.File. Exposing broad storage as a document
            provider keeps every existing SAF-shaped consumer (file operations, recycle bin,
            archives, backup, history) working against ordinary content:// URIs instead of needing
            a second, parallel File-based backend.

            android:permission="android.permission.MANAGE_DOCUMENTS" is signature-level, so no
            third-party app can read this provider; same-UID callers (Fylz itself) bypass the
            check. android:exported must stay true for the platform DocumentsUI to enumerate it.
        -->
        <provider
            android:name="io.github.mbaliga.fylz.storage.FylzFilesDocumentsProvider"
            android:authorities="io.github.mbaliga.fylz.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <activity
            android:name=".PostV1ToolsActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
            IndexManagerActivity was never declared, which made the whole index/ package
            unreachable at runtime — starting it threw ActivityNotFoundException. Declared here
            and reached from the Tools surface and a launcher shortcut.

            exported="true" matches its two sibling tool activities: a static launcher shortcut
            is started by the launcher process, not by Fylz, so the target must be exported for the
            shortcut in res/xml/shortcuts.xml to work.
        -->
        <activity
            android:name=".IndexManagerActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OperationHistoryActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Home-screen widgets (docs/widgets.md). Providers are exported because launchers bind
            them; each one only redraws widgets bound to it, whatever ids an intent names
            (widget/FylzWidgets.kt, WidgetIds.owned). The clock,
            time-zone and locale broadcasts are exempt from Android's implicit-broadcast limits and
            redraw day words and strings; the media broadcasts redraw Space when a volume comes or
            goes. The tick and action receivers below are reached only by Fylz's own explicit,
            immutable PendingIntents.
        -->
        <receiver
            android:name=".widget.SpaceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_space_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <action android:name="android.intent.action.MEDIA_REMOVED" />
                <action android:name="android.intent.action.MEDIA_BAD_REMOVAL" />
                <data android:scheme="file" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_space_info" />
        </receiver>

        <receiver
            android:name=".widget.BackupsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_backups_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_backups_info" />
        </receiver>

        <receiver
            android:name=".widget.RecoveryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_recovery_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recovery_info" />
        </receiver>

        <receiver
            android:name=".widget.OperationsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_operations_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_operations_info" />
        </receiver>

        <receiver
            android:name=".widget.FoldersWidgetProvider"
            android:exported="true"
            android:label="@string/widget_folders_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folders_info" />
        </receiver>

        <receiver
            android:name=".widget.IndexWidgetProvider"
            android:exported="true"
            android:label="@string/widget_index_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_index_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

    </application>

</manifest>
