<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Normal (non-dangerous) permission, no runtime request needed: required for the
         LocalHapticFeedback.performHapticFeedback(LongPress) calls entryGestures() (and the
         desktop/canvas tile gestures beside it) fire on a long-press; Compose routes those
         through the platform Vibrator under the hood. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Fylz is a file manager: full filesystem access is its default posture, not an opt-in
        extra. MANAGE_EXTERNAL_STORAGE is a special access permission and cannot be requested
        with a runtime permission dialog; storage.FullAccessPermission sends the user to the
        system "All files access" screen and re-checks Environment.isExternalStorageManager()
        when they return.

        Declining is survivable: StorageAccess falls back to the Storage Access Framework path,
        which also remains the only way to reach cloud, USB and third-party DocumentsProvider
        roots that this permission does not cover.

        tools:ignore="ScopedStorage" — lint flags this permission unconditionally. Publishing on
        Google Play with it requires the file-manager Permissions Declaration and eligibility
        review; see docs/ARCHITECTURE.md.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        Declared android:required="false": a file manager must not be filtered off the Play
        Store (or any other listing) for devices that simply don't support live wallpapers —
        FylzPondWallpaperService is an optional extra, never a requirement to install or run the
        app itself.
    -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <application
        android:name=".FylzApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fylz"
        android:usesCleartextTraffic="false">

        <!--
            Fylz's own DocumentsProvider over java.io.File. Exposing broad storage as a document
            provider keeps every existing SAF-shaped consumer (file operations, recycle bin,
            archives, backup, history) working against ordinary content:// URIs instead of needing
            a second, parallel File-based backend.

            android:permission="android.permission.MANAGE_DOCUMENTS" is signature-level, so no
            third-party app can read this provider; same-UID callers (Fylz itself) bypass the
            check. android:exported must stay true for the platform DocumentsUI to enumerate it.
        -->
        <provider
            android:name="io.github.mbaliga.fylz.storage.FylzFilesDocumentsProvider"
            android:authorities="io.github.mbaliga.fylz.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <activity
            android:name=".PostV1ToolsActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
            IndexManagerActivity was never declared, which made the whole index/ package
            unreachable at runtime — starting it threw ActivityNotFoundException. Declared here
            and reached from the Tools surface and a launcher shortcut.

            exported="true" matches its two sibling tool activities: a static launcher shortcut
            is started by the launcher process, not by Fylz, so the target must be exported for the
            shortcut in res/xml/shortcuts.xml to work.
        -->
        <activity
            android:name=".IndexManagerActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OperationHistoryActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The three app widgets. exported="false" on all three, per the current platform
            guidance for AppWidgetProvider receivers: APPWIDGET_UPDATE is a protected broadcast
            the system delivers by explicit component name (AppWidgetManager, not another app's
            process), so it reaches a non-exported receiver regardless — unlike
            FolderWidgetConfigActivity below, which the launcher/widget host genuinely does start
            from another app's process and so must stay exported.
        -->
        <receiver
            android:name=".widgets.StorageWidgetProvider"
            android:exported="false"
            android:label="@string/widget_storage_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_storage_info" />
        </receiver>

        <receiver
            android:name=".widgets.FolderShortcutWidgetProvider"
            android:exported="false"
            android:label="@string/widget_folder_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_folder_info" />
        </receiver>

        <receiver
            android:name=".widgets.QuickActionsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_actions_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_actions_info" />
        </receiver>

        <!-- Launched by the widget host (the launcher app's own process) via
             APPWIDGET_CONFIGURE, so — unlike the receivers above — this must be exported. -->
        <activity
            android:name=".widgets.FolderWidgetConfigActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            The share-in door. exported="true" is required for any other app's share sheet to
            reach it; excludeFromRecents="true" because its whole life is "copy, toast, finish" —
            a stale copy of it in the recents list would let a user reopen a share flow with
            nothing left to do. mimeType "*/*" per the plan: Fylz is a file manager and should
            accept whatever another app is willing to share, not pre-filter by type.
        -->
        <activity
            android:name=".share.SendToFylzActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Fylz">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            Workstream B's live wallpaper. Declared here (AndroidManifest.xml's sole owner this
            build) exactly as specified: BIND_WALLPAPER is a signature/system permission, so
            exported="true" does not open this service to arbitrary callers — only the platform
            wallpaper picker (which holds that permission) can bind to it.
        -->
        <service
            android:name=".wallpaper.FylzPondWallpaperService"
            android:exported="true"
            android:label="@string/fylz_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/fylz_wallpaper" />
        </service>
    </application>

</manifest>
