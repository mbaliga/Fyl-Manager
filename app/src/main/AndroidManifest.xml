<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        P0.12: without this, Android 11+'s package-visibility rules hide every third-party
        DocumentsProvider from queryIntentContentProviders, including USB drivers like
        Paragon's, so SafStorageProvider.providerRoots() silently sees only the platform's own
        providers no matter what the user has installed.
    -->
    <queries>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Normal (non-dangerous) permission, no runtime request needed: required for
         HyleTabHaptics.settle()'s direct VibratorManager.vibrate() call. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- P0.12: declared here; P1.2 requests it at runtime for the backup/long-operation
         foreground notifications. Merely declaring it changes nothing on its own. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Fylz is a file manager: full filesystem access is its default posture, not an opt-in
        extra. MANAGE_EXTERNAL_STORAGE is a special access permission and cannot be requested
        with a runtime permission dialog; storage.FullAccessPermission sends the user to the
        system "All files access" screen and re-checks Environment.isExternalStorageManager()
        when they return.

        Declining is survivable: StorageAccess falls back to the Storage Access Framework path,
        which also remains the only way to reach cloud, USB and third-party DocumentsProvider
        roots that this permission does not cover.

        tools:ignore="ScopedStorage" — lint flags this permission unconditionally. Publishing on
        Google Play with it requires the file-manager Permissions Declaration and eligibility
        review; see docs/ARCHITECTURE.md.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".FylzApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fylz"
        android:usesCleartextTraffic="false">

        <!--
            Fylz's own DocumentsProvider over java.io.File. Exposing broad storage as a document
            provider keeps every existing SAF-shaped consumer (file operations, recycle bin,
            archives, backup, history) working against ordinary content:// URIs instead of needing
            a second, parallel File-based backend.

            android:permission="android.permission.MANAGE_DOCUMENTS" is signature-level, so no
            third-party app can read this provider; same-UID callers (Fylz itself) bypass the
            check. android:exported must stay true for the platform DocumentsUI to enumerate it.
        -->
        <provider
            android:name="io.github.mbaliga.fylz.storage.FylzFilesDocumentsProvider"
            android:authorities="io.github.mbaliga.fylz.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
            M2.4: the isolated decoder process (docs/agent/MASTER_PLAN.md section 4.4). Native
            code parsing untrusted file content runs here, never in the UI process:
            isolatedProcess strips it down to no permissions of its own (it cannot open a file by
            path; every input arrives as a ParcelFileDescriptor the caller already holds open),
            and a separate process means a native crash while decoding a hostile file cannot take
            the host app down with it. exported="false": only DecoderClient, in this same app,
            ever binds to it.
        -->
        <service
            android:name=".decoder.DecoderService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":decoders" />

        <!--
            P0.12: exported="false" on this and its two siblings below (IndexManagerActivity,
            OperationHistoryActivity). None of the three has an intent-filter another app could
            target anyway; a launcher shortcut with an explicit targetClass (res/xml/shortcuts.xml)
            still starts a non-exported activity, because the shortcut is published by this same
            app, not by the launcher process on its own behalf. See res/xml/shortcuts.xml.
        -->
        <activity
            android:name=".PostV1ToolsActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
            IndexManagerActivity was never declared, which made the whole index/ package
            unreachable at runtime — starting it threw ActivityNotFoundException. Declared here
            and reached from the Tools surface and a launcher shortcut.
        -->
        <activity
            android:name=".IndexManagerActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OperationHistoryActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- P0.5's interim android:configChanges line lived here, papering over rotation and
                 fold/resize by preventing the Activity from ever being recreated for them. P1.10
                 removed it: BrowserViewModel plus SavedStateHandle/SessionStore now survive a real
                 recreation (config change or process death), so nothing needs to be suppressed. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- P0.12: widened to the families PreviewPane actually renders (FileFormatRegistry),
                 not just a handful of text/document types: "Open with Fylz" now shows up for
                 anything the app can meaningfully preview, down to a generic binary/unknown
                 fallback via application/octet-stream. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="font/*" />
                <data android:mimeType="model/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>

</manifest>
